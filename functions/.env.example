# Copy this file to functions/.env (gitignored) and fill in real values.
# Firebase Functions v2 auto-loads functions/.env at deploy/runtime — no
# extra wiring needed.

GEMINI_API_KEY=your-gemini-api-key-here

# Model to use for compositing. Flash is the default (cheap/fast); switch to
# the Pro model for print-quality output if needed later.
GEMINI_MODEL=gemini-3.1-flash-image-preview

# How long a session's images stay before the cleanup job deletes them (hrs).
SESSION_TTL_HOURS=2
