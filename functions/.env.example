# Copy this file to functions/.env (gitignored) and fill in real values.
# Firebase Functions v2 auto-loads functions/.env at deploy/runtime — no
# extra wiring needed.

GEMINI_API_KEY=your-gemini-api-key-here

# Model to use for compositing. Nano Banana Pro is the default — it's the
# only one of the two that supports the imageConfig.imageSize control below.
# Switch to gemini-3.1-flash-image-preview for ~1/3 the cost if 4K isn't
# needed (it ignores GEMINI_IMAGE_SIZE and tops out around 1300x768).
GEMINI_MODEL=gemini-3-pro-image-preview

# Output resolution for the Pro model: "1K", "2K", or "4K". Ignored by Flash.
GEMINI_IMAGE_SIZE=4K

# How long a session's images stay before the cleanup job deletes them (hrs).
SESSION_TTL_HOURS=2
