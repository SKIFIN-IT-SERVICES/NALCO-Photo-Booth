# Copy this file to functions/.env (gitignored) and fill in real values.
# Firebase Functions v2 auto-loads functions/.env at deploy/runtime — no
# extra wiring needed.

GEMINI_API_KEY=your-gemini-api-key-here

# Model + resolution are no longer fixed here — the visitor's quality-tier
# choice (Standard/HD/2K/4K) on the Format screen picks the model and
# imageSize per request. See functions/src/format.ts for that mapping.

# How long a session's images stay before the cleanup job deletes them (hrs).
SESSION_TTL_HOURS=2

# Fixed daily access code — the booth is locked until someone enters this
# correctly, then it's locked again for everyone until the next calendar
# day (Asia/Kolkata). Change this to whatever code staff will share/post
# that day; it's the same code all day, not regenerated per visitor.
OTP_CODE=123456
